#!/usr/bin/env sh
# .githooks/pre-push
# Pre-push Hook
#
# Author: Edward Silva
# Creation Date: 01 November, 2026
# Last Update: 14 November, 2026
#
# Runs scripts/scrub-private.js on the commits being pushed, then checks that information/
# points at a commit on its main branch.
#
# Usage:
# $ `npm run hooks:install` : Registers .githooks, so git runs this before every push
#
# Copyright (c) 2026 Edward Silva. All rights reserved.

set -e

node scripts/scrub-private.js push
node scripts/information.js check
echo "[pre-push] information/ points at its main branch. Proceeding with push."
