#!/usr/bin/env sh
# .githooks/pre-commit
# Pre-commit Hook
#
# Author: Edward Silva
# Creation Date: 01 November, 2026
# Last Update: 14 November, 2026
#
# Rebuilds the resume and CV PDFs and stages each only when its text changed, then runs
# scripts/scrub-private.js on the staged files.
#
# Usage:
# $ `npm run hooks:install` : Registers .githooks, so git runs this before every commit
#
# Copyright (c) 2026 Edward Silva. All rights reserved.

set -e

PDF=public/resume/Edward_Silva_Resume.pdf

echo "[pre-commit] Building resume PDF locally..."
npm run --silent build:resume

# A different TeX distribution changes the PDF bytes with no content change, so the hook keeps
# the committed file when the text matches HEAD and stages the rebuild only when the text differs.
if command -v pdftotext >/dev/null 2>&1 && git cat-file -e "HEAD:$PDF" 2>/dev/null; then
  old_text=$(git show "HEAD:$PDF" | pdftotext -layout - - | cksum)
  new_text=$(pdftotext -layout "$PDF" - | cksum)

  if [ "$old_text" = "$new_text" ]; then
    git checkout HEAD -- "$PDF"
    echo "[pre-commit] Resume text unchanged. Kept the committed PDF."
  else
    git add "$PDF"
  fi
else
  git add "$PDF"
fi

CV=public/cv/Edward_Silva_CV.pdf

echo "[pre-commit] Building CV PDF locally..."
npm run --silent build:cv

if command -v pdftotext >/dev/null 2>&1 && git cat-file -e "HEAD:$CV" 2>/dev/null; then
  old_text=$(git show "HEAD:$CV" | pdftotext -layout - - | cksum)
  new_text=$(pdftotext -layout "$CV" - | cksum)

  if [ "$old_text" = "$new_text" ]; then
    git checkout HEAD -- "$CV"
    echo "[pre-commit] CV text unchanged. Kept the committed PDF."
  else
    git add "$CV"
  fi
else
  git add "$CV"
fi

node scripts/scrub-private.js staged
echo "[pre-commit] Resume check done. Proceeding with commit."
