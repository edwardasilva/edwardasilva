#!/usr/bin/env sh
set -e

echo "[pre-commit] Building resume PDF locally..."
npm run --silent build:resume
git add public/resume/Edward_Silva_Resume.pdf

# Commit the changes in information/ first, so the add below records its new pointer.
node scripts/information.js commit

# Ensure cleanup changes are included in this commit.
git add -u
node scripts/scrub-private.js staged
echo "[pre-commit] Resume built and staged. Proceeding with commit."
