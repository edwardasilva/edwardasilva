{
    "name": "easilva.com",
    "license": "MIT",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "dev": "astro dev",
        "build": "npm run build:thumbs && npm run build:resume && astro build",
        "build:thumbs": "node scripts/generate-pdf-thumbs.js",
        "build:resume": "node scripts/build-resume.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --check",
        "format:fix": "prettier . --write",
        "clean:code": "npm run lint:fix && npm run format:fix",
        "hooks:install": "node scripts/setup-git-hooks.js",
        "prepare": "npm run hooks:install",
        "sync:resume-secret": "node scripts/sync-resume-secret.js",
        "sync:resume-secret:env": "node scripts/sync-resume-secret.js --scope=env --env=github-pages",
        "sync:ai-configs": "node scripts/configs.js",
        "all": "node scripts/run-all.js",
        "preview": "astro preview",
        "astro": "astro"
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.2",
        "@fontsource/carlito": "^5.2.8",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/vite": "^4.1.18",
        "astro": "^7.1.1",
        "satori": "^0.26.0",
        "satori-html": "^0.3.2",
        "tailwindcss": "^4.1.18"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@typescript-eslint/eslint-plugin": "^8.43.0",
        "@typescript-eslint/parser": "^8.43.0",
        "astro-eslint-parser": "^1.2.2",
        "eslint": "^9.35.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.3.1",
        "globals": "^16.4.0",
        "pdf-to-img": "^6.2.0",
        "prettier": "^3.8.2",
        "prettier-plugin-astro": "^0.14.1"
    }
}
