{
  "name": "edwardasilva.com",
  "license": "MIT",
  "type": "module",
  "version": "1.0.0",
  "prettier": "./.lint/.prettierrc.json",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build:thumbs && npm run build:resume && astro build",
    "build:thumbs": "node scripts/generate-pdf-thumbs.js",
    "build:resume": "node scripts/build-resume.js",
    "figures": "node scripts/theme-figures.js",
    "figures:check": "node scripts/theme-figures.js --check",
    "check:links": "node scripts/check-links.js",
    "prose": "vale --config .lint/vale/.vale.ini src/content/docs",
    "lint": "eslint --config .lint/eslint.config.js .",
    "lint:fix": "eslint --config .lint/eslint.config.js . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --config .lint/.prettierrc.json --ignore-path .lint/.prettierignore . --check",
    "format:fix": "prettier --config .lint/.prettierrc.json --ignore-path .lint/.prettierignore . --write",
    "clean:code": "npm run lint:fix && npm run format:fix",
    "hooks:install": "node scripts/setup-git-hooks.js",
    "scrub:private": "node scripts/scrub-private.js staged",
    "prepare": "npm run hooks:install",
    "info:setup": "node scripts/information.js setup",
    "info:status": "node scripts/information.js status",
    "info:pull": "node scripts/information.js pull",
    "info:save": "node scripts/information.js save",
    "all": "node scripts/run-all.js",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/starlight": "0.42.9",
    "@fontsource-variable/source-code-pro": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.6",
    "katex": "0.19.0",
    "pdfjs-dist": "6.4.299",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^17.14.0",
    "pdf-to-img": "^7.0.2",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "katex": "$katex"
  }
}
