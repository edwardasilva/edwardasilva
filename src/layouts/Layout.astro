---
/**
 * src/layouts/Layout.astro
 * Layout Component
 *
 * Author: Edward Silva
 * Creation Date: 16 March, 2026
 * Last Update: 18 July, 2026
 *
 * Defines the shared HTML structure, metadata, and canonical links.
 *
 * File Structure:
 * - Imports and Props
 * - Canonical/OpenGraph URL composition
 * - Page template and slot rendering
 *
 * Where this file is used within the repository:
 * - All pages under src/pages/
 *
 * Licence/Copyright: Licensed under MIT License
 */

// Base layout - handles meta tags and fonts
import '../styles/global.css';
import faviconUrl from '../styles/favicon.svg?url';
import { getProfileHighlightText, resume } from '../data/resume';

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
}

const {
    title = `${resume.personal.name} | Portfolio`,
    description = getProfileHighlightText(resume.about),
    ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://easilva.com');
const socialImageURL = new URL(ogImage || '/favicon.svg', Astro.site ?? 'https://easilva.com');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="author" content={resume.personal.name} />
        <meta name="theme-color" content="#f3f5f7" />
        <meta name="robots" content="index,follow,max-image-preview:large" />

        <!-- Open Graph / Social -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:locale" content="en_US" />
        <meta property="og:site_name" content="Edward Silva Portfolio" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImageURL} />

        <!-- Schema.org Profile JSON-LD -->
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'Person',
                name: resume.personal.name,
                url: resume.personal.website,
                image: socialImageURL,
                alumniOf: {
                    '@type': 'CollegeOrUniversity',
                    name: 'Colorado School of Mines',
                    sameAs: 'https://en.wikipedia.org/wiki/Colorado_School_of_Mines',
                },
                jobTitle: 'Embedded Software Engineer',
                description: getProfileHighlightText(resume.about),
                sameAs: [resume.personal.linkedin, resume.personal.github],
            })}
        />
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'WebSite',
                name: `${resume.personal.name} Portfolio`,
                url: resume.personal.website,
            })}
        />

        <!-- Favicons -->
        <link rel="icon" href={faviconUrl} sizes="any" type="image/svg+xml" />
        <link rel="shortcut icon" href={faviconUrl} type="image/svg+xml" />
        <link rel="apple-touch-icon" href={faviconUrl} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalURL} />
        <title>{title}</title>
    </head>
    <body class="bg-paper text-ink font-sans antialiased flex flex-col min-h-screen">
        <slot />
    </body>
</html>
