---
/**
 * src/pages/projects/[slug].astro
 * Project Detail Route
 *
 * Author: Edward Silva
 * Creation Date: 30 March, 2026
 * Last Update: 18 July, 2026
 *
 * Generates static detail pages for portfolio projects.
 *
 * File Structure:
 * - Imports and static path generation
 * - Route props and OG image setup
 * - Project detail template
 *
 * Where this file is used within the repository:
 * - Dynamic route /projects/[slug]
 *
 * Licence/Copyright: Licensed under MIT License
 */

import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectProofRenderer from '../../components/ProjectProofRenderer.astro';
import {
    getPortfolioProjects,
    getProjectHighlights,
    getProjectSkills,
    getProjectSlug,
} from '../../data/resume';
import type { Project } from '../../data/types';
import Layout from '../../layouts/Layout.astro';

/**
 * @brief Returns static route params for each portfolio project detail page.
 * @return Static path list with slug params and typed props payload.
 */
export function getStaticPaths() {
    return getPortfolioProjects().map((project) => ({
        params: { slug: getProjectSlug(project) },
        props: { project },
    }));
}

const { project } = Astro.props as { project: Project };
const ogImageUrl = `/og/${getProjectSlug(project)}.png`;
const highlights = getProjectHighlights(project);
const relatedSkills = getProjectSkills(project);
---

<Layout
    title={`${project.title} | Project`}
    description={project.summary ?? highlights[0] ?? project.title}
    ogImage={ogImageUrl}
>
    <Header />
    <main class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
        <section class="border-b border-line pb-8 sm:pb-10">
            <h1 class="font-serif text-3xl text-ink sm:text-4xl">{project.title}</h1>
            <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                <span>{project.duration}</span>
                <span aria-hidden="true" class="h-3 w-px bg-line" />
                <span>{project.projectType}</span>
                {
                    project.course && (
                        <>
                            <span aria-hidden="true" class="h-3 w-px bg-line" />
                            <span>{project.course}</span>
                        </>
                    )
                }
            </p>
            <p class="mt-4 text-base text-faint">{project.summary}</p>

            {
                relatedSkills.length > 0 && (
                    <p class="mt-5 text-xs text-dim">{relatedSkills.join(', ')}</p>
                )
            }

            {
                project.github && (
                    <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-5 inline-flex items-center rounded-md bg-ink px-3 py-2 text-sm font-medium text-white hover:bg-ink-soft"
                    >
                        Source code
                    </a>
                )
            }
        </section>

        {
            highlights.length > 0 && (
                <section class="border-b border-line py-8 last:border-0 last:pb-0 sm:py-10">
                    <h2 class="font-serif text-xl text-ink sm:text-2xl">Details</h2>
                    <ul class="list-dash mt-4 space-y-3 text-sm text-faint sm:text-base">
                        {highlights.map((line) => (
                            <li>{line}</li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            project.proof && project.proof.length > 0 && (
                <section class="space-y-4 pt-8 sm:pt-10">
                    <h2 class="font-serif text-xl text-ink sm:text-2xl">Reports & media</h2>
                    <div class="flex flex-wrap gap-4">
                        {project.proof.map((proof) => (
                            <ProjectProofRenderer proof={proof} />
                        ))}
                    </div>
                </section>
            )
        }
    </main>
    <Footer />
</Layout>
