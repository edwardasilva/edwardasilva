---
/**
 * src/pages/projects/[slug].astro
 * Project Detail Page
 *
 * Author: Edward Silva
 * Creation Date: 30 March, 2026
 * Last Update: 13 October, 2026
 *
 * Generates static detail pages for portfolio projects.
 *
 * File Structure:
 * - Imports and static path generation
 * - Route props and OG image resolution
 * - Project detail page template with accessible landmarks
 *
 * Where this file is used within the repository:
 * - Public routes under /projects/[slug]
 *
 * Usage:
 * $ `npm run dev` : Serves project detail routes at http://localhost:4321/projects/[slug]
 *
 * Copyright (c) 2026 Edward Silva. All rights reserved.
 * NOTICE: This file contains personal biographical data.
 * It is strictly excluded from the repository's MIT License and
 * may not be reproduced, distributed, or modified without permission.
 */

import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import ProofRenderer from '../../components/ProofRenderer.astro';
import SkillLinks from '../../components/SkillLinks.astro';
import {
    getCourseHref,
    getPortfolioProjects,
    getProjectHighlights,
    getProjectSkills,
    getProjectSlug,
} from '../../data/resume';
import type { Project } from '../../data/types';

/**
 * @brief Returns the static route parameters for every portfolio project
 * @return Array of route parameters and props for Astro static path generation
 */
export function getStaticPaths() {
    return getPortfolioProjects().map((project) => ({
        params: { slug: getProjectSlug(project) },
        props: { project },
    }));
}

interface Props {
    project: Project;
}

const { project } = Astro.props;
const slug = getProjectSlug(project);
const highlights = getProjectHighlights(project);
const relatedSkills = getProjectSkills(project);
const proof = project.proof ?? [];
const courseHref = getCourseHref(project.course);
const ogImageUrl = `/og/${slug}.png`;

const projectJsonLd = {
    '@type': project.github ? 'SoftwareSourceCode' : 'CreativeWork',
    name: project.title,
    description: project.Summary ?? highlights[0] ?? project.title,
    author: {
        '@type': 'Person',
        name: 'Edward Silva',
        url: 'https://edwardasilva.com',
    },
    ...(project.github ? { codeRepository: project.github } : {}),
    ...(relatedSkills.length > 0 ? { keywords: relatedSkills.join(', ') } : {}),
};
---

<Layout
    title={`${project.title} | Project`}
    description={project.Summary ?? highlights[0] ?? project.title}
    ogImage={ogImageUrl}
    jsonLd={projectJsonLd}
>
    <Header />
    <main
        id="main-content"
        tabindex="-1"
        class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8"
    >
        <section class="border-b border-line pb-8 sm:pb-10">
            <h1 class="font-serif text-3xl text-ink sm:text-4xl">{project.title}</h1>
            <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                <span>{project.duration}</span>
                {
                    project.course && (
                        <>
                            <span aria-hidden="true" class="h-3 w-px bg-line" />
                            {courseHref ? (
                                <a
                                    href={courseHref}
                                    class="hover:text-accent hover:underline underline-offset-4"
                                    aria-label={`View coursework details for ${project.course}`}
                                >
                                    {project.course}
                                </a>
                            ) : (
                                <span>{project.course}</span>
                            )}
                        </>
                    )
                }
            </p>
            <SkillLinks skills={relatedSkills} class="mt-3" />

            {project.Summary && <p class="mt-4 text-base text-faint">{project.Summary}</p>}

            {
                project.github && (
                    <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-5 inline-flex items-center rounded-md bg-ink px-3 py-2 text-sm font-medium text-white hover:bg-ink-soft"
                        aria-label={`View source code for ${project.title} on GitHub (opens in a new tab)`}
                    >
                        Source code
                        <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                )
            }
        </section>

        {
            highlights.length > 0 && (
                <section
                    class="border-b border-line py-8 last:border-0 last:pb-0 sm:py-10"
                    role="region"
                    aria-label="Project Details"
                >
                    <h2 class="font-serif text-xl text-ink sm:text-2xl">Details</h2>
                    <ul class="list-dash mt-4 space-y-3 text-sm text-faint sm:text-base">
                        {highlights.map((line) => (
                            <li>{line}</li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            proof.length > 0 && (
                <section
                    class="space-y-4 pt-8 sm:pt-10"
                    role="region"
                    aria-label="Reports and Media"
                >
                    <h2 class="font-serif text-xl text-ink sm:text-2xl">Reports & media</h2>
                    <div class="flex flex-wrap gap-4">
                        {proof.map((item) => (
                            <ProofRenderer proof={item} />
                        ))}
                    </div>
                </section>
            )
        }
    </main>
    <Footer />
</Layout>
