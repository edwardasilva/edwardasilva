import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { getHomeProjectPages, getPageSlug } from '../data/projects';
import { asSentence, resume } from '../data/resume';
import { itemListSchema, jsonLdHeadTag } from '../data/structured-data';

const projects = [
    ...getHomeProjectPages('selected'),
    ...getHomeProjectPages('more'),
    ...getHomeProjectPages('index'),
];
const site = Astro.site ?? Astro.url;

const schema = itemListSchema(
    'Projects',
    projects.map(({ entry }) => ({
        name: entry.data.title,
        path: `/projects/${getPageSlug(entry.id)}`,
    })),
    site
);
---

<StarlightPage
    frontmatter={{
        title: 'Projects',
        description: asSentence(resume.site.pages.projects.description),
        head: [jsonLdHeadTag(schema)],
        tableOfContents: false,
    }}
>
    <ProjectCards pages={projects} />
</StarlightPage>
