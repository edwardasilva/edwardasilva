import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { getPageSlug, getProjectPages } from '../data/projects';
import { itemListSchema, jsonLdHeadTag } from '../data/structured-data';

const projects = await getProjectPages('project');
const personal = await getProjectPages('personal');
const site = Astro.site ?? Astro.url;

const schema = itemListSchema(
    'Projects',
    [...projects, ...personal].map((page) => ({
        name: page.data.title,
        path: `/projects/${getPageSlug(page.id)}`,
    })),
    site
);
---

<StarlightPage
    frontmatter={{
        title: 'Projects',
        description:
            'Projects by Edward Silva, built from the reports, code, and data behind them, with interactive figures.',
        head: [jsonLdHeadTag(schema)],
        tableOfContents: false,
    }}
>
    <p>To find projects by tool, see the <a href="/skills/">skills index</a>.</p>

    <ProjectCards pages={projects} />

    <h2>Personal projects</h2>
    <ProjectCards pages={personal} />
</StarlightPage>
