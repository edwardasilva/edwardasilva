---
/**
 * src/pages/projects.astro
 * Projects Index Page
 *
 * Author: Edward Silva
 * Creation Date: 30 March, 2026
 * Last Update: 25 August, 2026
 *
 * Renders the projects directory view and links each project to its detail route.
 *
 * File Structure:
 * - Imports and project selection
 * - Projects list template with accessibility landmarks
 *
 * Where this file is used within the repository:
 * - Public route /projects
 *
 * Usage:
 * $ `npm run dev` : Serves projects page at http://localhost:4321/projects
 *
 * Copyright (c) 2026 Edward Silva. All rights reserved.
 * NOTICE: This file contains personal biographical data.
 * It is strictly excluded from the repository's MIT License and
 * may not be reproduced, distributed, or modified without permission.
 */

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import SkillLinks from '../components/SkillLinks.astro';
import {
    getCourseHref,
    getPortfolioProjects,
    getProjectSkills,
    getProjectSlug,
} from '../data/resume';

const projects = getPortfolioProjects();

const projectsJsonLd = {
    '@type': 'ItemList',
    name: 'Projects Directory',
    itemListElement: projects.map((proj, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: proj.title,
        url: `https://edwardasilva.com/projects/${getProjectSlug(proj)}`,
    })),
};
---

<Layout
    title="Projects | Edward Silva"
    description="Project list with links to details and files."
    jsonLd={projectsJsonLd}
>
    <Header />
    <main
        id="main-content"
        tabindex="-1"
        class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8"
    >
        <section class="border-b border-line pb-8 sm:pb-10">
            <h1 class="font-serif text-3xl text-ink sm:text-4xl">Projects</h1>
        </section>

        <section class="divide-y divide-line" role="region" aria-label="Projects Directory">
            {
                projects.map((project) => {
                    const relatedSkills = getProjectSkills(project);
                    const courseHref = getCourseHref(project.course);

                    const projectHref = `/projects/${getProjectSlug(project)}`;
                    return (
                        <article class="py-8 sm:py-10">
                            <header class="mb-3">
                                <h2 class="font-serif text-lg text-ink sm:text-xl">
                                    <a
                                        href={projectHref}
                                        class="hover:text-accent hover:underline underline-offset-4"
                                    >
                                        {project.title}
                                    </a>
                                </h2>
                                <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                                    <span>{project.duration}</span>
                                    {project.course && (
                                        <>
                                            <span class="text-dim">·</span>
                                            {courseHref ? (
                                                <a
                                                    href={courseHref}
                                                    class="hover:text-accent hover:underline underline-offset-4"
                                                    aria-label={`View coursework details for ${project.course}`}
                                                >
                                                    {project.course}
                                                </a>
                                            ) : (
                                                <span>{project.course}</span>
                                            )}
                                        </>
                                    )}
                                </p>
                            </header>

                            <SkillLinks skills={relatedSkills} class="mt-2" />

                            {project.Summary && (
                                <p class="mt-3 text-sm text-faint leading-relaxed sm:text-base">
                                    {project.Summary}
                                </p>
                            )}
                        </article>
                    );
                })
            }
        </section>
    </main>
    <Footer />
</Layout>
