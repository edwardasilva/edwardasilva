---
/**
 * src/pages/projects.astro
 * Projects Index Page
 *
 * Author: Edward Silva
 * Creation Date: 30 March, 2026
 * Last Update: 18 July, 2026
 *
 * Renders the projects directory view and links each project to its detail route.
 *
 * File Structure:
 * - Imports and project selection
 * - Projects list template
 *
 * Where this file is used within the repository:
 * - Public route /projects
 *
 * Licence/Copyright: Licensed under MIT License
 */

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import { getPortfolioProjects, getProjectSkills, getProjectSlug } from '../data/resume';

const projects = getPortfolioProjects();
---

<Layout title="Projects | Edward Silva" description="Project list with links to details and files.">
    <Header />
    <main class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
        <section class="border-b border-line pb-8 sm:pb-10">
            <h1 class="font-serif text-3xl text-ink sm:text-4xl">Projects</h1>
        </section>

        <section class="divide-y divide-line">
            {
                projects.map((project) => {
                    const relatedSkills = getProjectSkills(project);

                    return (
                        <article class="py-8 sm:py-10">
                            <h2 class="font-serif text-lg text-ink sm:text-xl">
                                <a
                                    href={`/projects/${getProjectSlug(project)}`}
                                    class="hover:text-accent hover:underline underline-offset-4"
                                >
                                    {project.title}
                                </a>
                            </h2>
                            <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                                <span>{project.duration}</span>
                                <span aria-hidden="true" class="h-3 w-px bg-line" />
                                <span>{project.projectType}</span>
                                {project.course && (
                                    <>
                                        <span aria-hidden="true" class="h-3 w-px bg-line" />
                                        <span>{project.course}</span>
                                    </>
                                )}
                            </p>
                            <p class="mt-3 text-sm text-faint leading-relaxed sm:text-base">
                                {project.summary}
                            </p>

                            {relatedSkills.length > 0 && (
                                <p class="mt-3 text-xs text-dim">{relatedSkills.join(', ')}</p>
                            )}
                        </article>
                    );
                })
            }
        </section>
    </main>
    <Footer />
</Layout>
