---
/**
 * src/pages/experiences/[slug].astro
 * Experience Detail Route
 *
 * Author: Edward Silva
 * Creation Date: 30 March, 2026
 * Last Update: 18 July, 2026
 *
 * Generates static detail pages for public experiences.
 *
 * File Structure:
 * - Imports and static path generation
 * - Route props and OG image setup
 * - Experience detail template
 *
 * Where this file is used within the repository:
 * - Dynamic route /experiences/[slug]
 *
 * Licence/Copyright: Licensed under MIT License
 */

import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import {
    getExperienceHighlights,
    getExperienceSkills,
    getExperienceSlug,
    getPublicExperiences,
} from '../../data/resume';
import type { Experience } from '../../data/types';
import Layout from '../../layouts/Layout.astro';

/**
 * @brief Returns static route params for each public experience detail page.
 * @return Static path list with slug params and typed props payload.
 */
export function getStaticPaths() {
    return getPublicExperiences().map((experience) => ({
        params: { slug: getExperienceSlug(experience) },
        props: { experience },
    }));
}

const { experience } = Astro.props as { experience: Experience };
const ogImageUrl = `/og/${getExperienceSlug(experience)}.png`;
const highlights = getExperienceHighlights(experience);
const relatedSkills = getExperienceSkills(experience);
---

<Layout
    title={`${experience.title} | Experience`}
    description={highlights[0] ?? experience.title}
    ogImage={ogImageUrl}
>
    <Header />
    <main class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
        <section class="border-b border-line pb-8 sm:pb-10">
            <h1 class="font-serif text-3xl text-ink sm:text-4xl">{experience.title}</h1>
            <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                {
                    experience.companyUrl ? (
                        <a
                            href={experience.companyUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-medium hover:text-accent hover:underline underline-offset-4"
                        >
                            {experience.company}
                        </a>
                    ) : (
                        <span class="font-medium">{experience.company}</span>
                    )
                }
                <span aria-hidden="true" class="h-3 w-px bg-line" />
                <span>{experience.location}</span>
                <span aria-hidden="true" class="h-3 w-px bg-line" />
                <span>{experience.duration}</span>
            </p>

            {
                relatedSkills.length > 0 && (
                    <p class="mt-4 text-xs text-dim">{relatedSkills.join(', ')}</p>
                )
            }
        </section>

        <section class="pt-8 sm:pt-10">
            <h2 class="font-serif text-xl text-ink sm:text-2xl">Highlights</h2>
            <ul class="list-dash mt-4 space-y-3 text-sm text-faint sm:text-base">
                {highlights.map((line) => <li>{line}</li>)}
            </ul>
        </section>
    </main>
    <Footer />
</Layout>
