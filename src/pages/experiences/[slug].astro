---
/**
 * src/pages/experiences/[slug].astro
 * Experience Detail Page
 *
 * Author: Edward Silva
 * Creation Date: 30 March, 2026
 * Last Update: 13 October, 2026
 *
 * Generates static detail pages for public experiences, including any proof material
 * attached to the role.
 *
 * File Structure:
 * - Imports and static path generation
 * - Route props and OG image resolution
 * - Experience detail page template with accessible landmarks
 *
 * Where this file is used within the repository:
 * - Public routes under /experiences/[slug]
 *
 * Usage:
 * $ `npm run dev` : Serves experience detail routes at http://localhost:4321/experiences/[slug]
 *
 * Copyright (c) 2026 Edward Silva. All rights reserved.
 * NOTICE: This file contains personal biographical data.
 * It is strictly excluded from the repository's MIT License and
 * may not be reproduced, distributed, or modified without permission.
 */

import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import ProofRenderer from '../../components/ProofRenderer.astro';
import SkillLinks from '../../components/SkillLinks.astro';
import {
    getExperienceHighlights,
    getExperienceSkills,
    getExperienceSlug,
    getPublicExperiences,
} from '../../data/resume';
import type { Experience } from '../../data/types';

/**
 * @brief Returns the static route parameters for every public experience entry
 * @return Array of route parameters and props for Astro static path generation
 */
export function getStaticPaths() {
    return getPublicExperiences().map((experience) => ({
        params: { slug: getExperienceSlug(experience) },
        props: { experience },
    }));
}

interface Props {
    experience: Experience;
}

const { experience } = Astro.props;
const slug = getExperienceSlug(experience);
const highlights = getExperienceHighlights(experience);
const relatedSkills = getExperienceSkills(experience);
const proof = experience.proof ?? [];
const ogImageUrl = `/og/experiences/${slug}.png`;

const experienceJsonLd = {
    '@type': 'Occupation',
    name: experience.title,
    description: experience.Summary ?? highlights[0] ?? experience.title,
    skills: relatedSkills.join(', '),
    hiringOrganization: {
        '@type': 'Organization',
        name: experience.company,
        ...(experience.companyUrl ? { sameAs: experience.companyUrl } : {}),
    },
};
---

<Layout
    title={`${experience.title} | Experience`}
    description={experience.Summary ?? highlights[0] ?? experience.title}
    ogImage={ogImageUrl}
    jsonLd={experienceJsonLd}
>
    <Header />
    <main
        id="main-content"
        tabindex="-1"
        class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8"
    >
        <section class="border-b border-line pb-8 sm:pb-10">
            <h1 class="font-serif text-3xl text-ink sm:text-4xl">{experience.title}</h1>
            <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                {
                    experience.companyUrl ? (
                        <a
                            href={experience.companyUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-medium hover:text-accent hover:underline underline-offset-4"
                            aria-label={`${experience.company} website (opens in a new tab)`}
                        >
                            {experience.company}
                            <span class="sr-only"> (opens in a new tab)</span>
                        </a>
                    ) : (
                        <span class="font-medium">{experience.company}</span>
                    )
                }
                {
                    experience.location && (
                        <>
                            <span aria-hidden="true" class="h-3 w-px bg-line" />
                            <span>{experience.location}</span>
                        </>
                    )
                }
                <span aria-hidden="true" class="h-3 w-px bg-line"></span>
                <span>{experience.duration}</span>
            </p>

            <SkillLinks skills={relatedSkills} class="mt-3" />

            {experience.Summary && <p class="mt-4 text-base text-faint">{experience.Summary}</p>}
        </section>

        {
            highlights.length > 0 && (
                <section
                    class="border-b border-line py-8 last:border-0 last:pb-0 sm:py-10"
                    role="region"
                    aria-label="Role Highlights"
                >
                    <h2 class="font-serif text-xl text-ink sm:text-2xl">Highlights</h2>
                    <ul class="list-dash mt-4 space-y-3 text-sm text-faint sm:text-base">
                        {highlights.map((line) => (
                            <li>{line}</li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            proof.length > 0 && (
                <section
                    class="space-y-4 pt-8 sm:pt-10"
                    role="region"
                    aria-label="Reports and Media"
                >
                    <h2 class="font-serif text-xl text-ink sm:text-2xl">Reports & media</h2>
                    <div class="flex flex-wrap gap-4">
                        {proof.map((item) => (
                            <ProofRenderer proof={item} />
                        ))}
                    </div>
                </section>
            )
        }
    </main>
    <Footer />
</Layout>
