---
/**
 * src/pages/education.astro
 * Education Detail Page
 *
 * Author: Edward Silva
 * Creation Date: 15 April, 2026
 * Last Update: 18 July, 2026
 *
 * Renders comprehensive education details including school information,
 * honors, scholarships, and coursework entries from resume data.
 *
 * File Structure:
 * - Imports and derived data
 * - Utility function for course code parsing
 * - Education detail page template
 *
 * Where this file is used within the repository:
 * - Public route /education
 *
 * Licence/Copyright: Licensed under MIT License
 */

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import { getPrimaryEducation, getVisibleCourseCategories, resume } from '../data/resume';

const primaryEducation = getPrimaryEducation();
const honors = resume.educationSupplementary?.honors ?? [];
const scholarships = resume.educationSupplementary?.scholarships ?? [];

const coursesByCategory = getVisibleCourseCategories(resume);

const description = primaryEducation
    ? `${primaryEducation.degree} at ${primaryEducation.institution}, graduated ${primaryEducation.graduationDate}.`
    : 'Education details.';
---

<Layout title="Education | Edward Silva" description={description}>
    <Header />
    <main class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
        <section class="border-b border-line pb-8 sm:pb-10">
            <h1 class="font-serif text-3xl text-ink sm:text-4xl">Education</h1>
        </section>

        {
            primaryEducation && (
                <section class="border-b border-line py-8 sm:py-10">
                    <h2 class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-serif text-xl text-ink sm:text-2xl">
                        <span>{primaryEducation.degree}</span>
                        {primaryEducation.minor && (
                            <span class="flex items-center gap-x-3 text-sm font-sans font-normal text-faint">
                                <span aria-hidden="true" class="hidden h-3 w-px bg-line sm:block" />
                                {primaryEducation.minor}
                            </span>
                        )}
                    </h2>
                    <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                        <a
                            href="https://www.mines.edu"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="font-medium hover:text-accent hover:underline underline-offset-4"
                        >
                            {primaryEducation.institution}
                        </a>
                        <span aria-hidden="true" class="hidden h-3 w-px bg-line sm:block" />
                        <span>{primaryEducation.location}</span>
                        <span aria-hidden="true" class="hidden h-3 w-px bg-line sm:block" />
                        <span>Graduated {primaryEducation.graduationDate}</span>
                        {primaryEducation.gpa && (
                            <>
                                <span aria-hidden="true" class="hidden h-3 w-px bg-line sm:block" />
                                <span>{primaryEducation.gpa} GPA</span>
                            </>
                        )}
                    </p>
                    {primaryEducation.specialization && (
                        <p class="mt-3 text-sm text-faint">{primaryEducation.specialization}</p>
                    )}
                </section>
            )
        }

        {
            (honors.length > 0 || scholarships.length > 0) && (
                <section class="grid grid-cols-1 gap-8 border-b border-line py-8 sm:grid-cols-2 sm:py-10">
                    {honors.length > 0 && (
                        <article>
                            <h2 class="font-serif text-xl text-ink sm:text-2xl">Honors</h2>
                            <ul class="list-dash mt-4 space-y-2 text-sm text-faint">
                                {honors.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        </article>
                    )}

                    {scholarships.length > 0 && (
                        <article>
                            <h2 class="font-serif text-xl text-ink sm:text-2xl">Scholarships</h2>
                            <ul class="list-dash mt-4 space-y-2 text-sm text-faint">
                                {scholarships.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        </article>
                    )}
                </section>
            )
        }

        <section class="pt-8 sm:pt-10">
            <h2 class="font-serif text-xl text-ink sm:text-2xl">Coursework</h2>

            {
                coursesByCategory.length > 0 && (
                    <div class="mt-5 space-y-6">
                        {coursesByCategory.map((entry) => (
                            <article>
                                <h3 class="text-base font-semibold text-ink sm:text-lg">
                                    {entry.category}
                                </h3>
                                <div class="mt-2 divide-y divide-line">
                                    {entry.courses.map((course) => (
                                        <details class="group">
                                            <summary class="flex cursor-pointer items-center gap-3 py-2.5 select-none list-none">
                                                <span class="w-20 shrink-0 font-mono text-xs text-dim">
                                                    {course.code}
                                                </span>
                                                <span class="flex-1 text-sm font-medium text-ink">
                                                    {course.name}
                                                    {course.alias && (
                                                        <span class="ml-2 text-xs font-normal text-dim">
                                                            ({course.alias})
                                                        </span>
                                                    )}
                                                </span>
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    width="16"
                                                    height="16"
                                                    viewBox="0 0 24 24"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    stroke-width="2"
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    class="shrink-0 text-dim group-open:rotate-180 transition-transform"
                                                >
                                                    <polyline points="6 9 12 15 18 9" />
                                                </svg>
                                            </summary>
                                            <p class="pb-3 text-sm leading-relaxed text-faint sm:pl-[5.75rem]">
                                                {course.description}
                                            </p>
                                        </details>
                                    ))}
                                </div>
                            </article>
                        ))}
                    </div>
                )
            }
        </section>
    </main>
    <Footer />
</Layout>
