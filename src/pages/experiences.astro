---
/**
 * src/pages/experiences.astro
 * Experiences Index Page
 *
 * Author: Edward Silva
 * Creation Date: 30 March, 2026
 * Last Update: 18 July, 2026
 *
 * Renders the experiences directory view and links each role to its detail route.
 *
 * File Structure:
 * - Imports and experience selection
 * - Experiences list template
 *
 * Where this file is used within the repository:
 * - Public route /experiences
 *
 * Licence/Copyright: Licensed under MIT License
 */

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import SkillLinks from '../components/SkillLinks.astro';
import {
    getExperienceHighlights,
    getExperienceSkills,
    getExperienceSlug,
    getPublicExperiences,
} from '../data/resume';

const experiences = getPublicExperiences();
---

<Layout
    title="Experience | Edward Silva"
    description="Professional experience, with details on each role."
>
    <Header />
    <main class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
        <section class="border-b border-line pb-8 sm:pb-10">
            <h1 class="font-serif text-3xl text-ink sm:text-4xl">Experience</h1>
        </section>

        <section class="divide-y divide-line">
            {
                experiences.map((experience) => {
                    const experienceHref = `/experiences/${getExperienceSlug(experience)}`;
                    const summary = experience.Summary ?? getExperienceHighlights(experience)[0];
                    const relatedSkills = getExperienceSkills(experience);
                    return (
                        <article class="py-8 sm:py-10">
                            <h2 class="font-serif text-lg text-ink sm:text-xl">
                                <a
                                    href={experienceHref}
                                    class="hover:text-accent hover:underline underline-offset-4"
                                >
                                    {experience.title}
                                </a>
                            </h2>
                            <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                                {experience.companyUrl ? (
                                    <a
                                        href={experience.companyUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="font-medium hover:text-accent hover:underline underline-offset-4"
                                    >
                                        {experience.company}
                                    </a>
                                ) : (
                                    <span class="font-medium">{experience.company}</span>
                                )}
                                <span aria-hidden="true" class="h-3 w-px bg-line" />
                                <span>{experience.location}</span>
                                <span aria-hidden="true" class="h-3 w-px bg-line" />
                                <span>{experience.duration}</span>
                            </p>

                            <SkillLinks skills={relatedSkills} class="mt-2" />

                            {summary && (
                                <p class="mt-3 text-sm text-faint leading-relaxed sm:text-base">
                                    {summary}
                                </p>
                            )}
                        </article>
                    );
                })
            }
        </section>
    </main>
    <Footer />
</Layout>
