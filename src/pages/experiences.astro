---
/**
 * src/pages/experiences.astro
 * Experiences Index Page
 *
 * Author: Edward Silva
 * Creation Date: 30 March, 2026
 * Last Update: 25 August, 2026
 *
 * Renders the experiences directory view and links each role to its detail route.
 *
 * File Structure:
 * - Imports and experience selection
 * - Experiences list template with accessibility landmarks
 *
 * Where this file is used within the repository:
 * - Public route /experiences
 *
 * Usage:
 * $ `npm run dev` : Serves experiences page at http://localhost:4321/experiences
 *
 * Copyright (c) 2026 Edward Silva. All rights reserved.
 * NOTICE: This file contains personal biographical data.
 * It is strictly excluded from the repository's MIT License and
 * may not be reproduced, distributed, or modified without permission.
 */

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import SkillLinks from '../components/SkillLinks.astro';
import {
    getExperienceHighlights,
    getExperienceSkills,
    getExperienceSlug,
    getPublicExperiences,
} from '../data/resume';

const experiences = getPublicExperiences();

const experiencesJsonLd = {
    '@type': 'ItemList',
    name: 'Work Experience Directory',
    itemListElement: experiences.map((exp, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: `${exp.title} at ${exp.company}`,
        url: `https://edwardasilva.com/experiences/${getExperienceSlug(exp)}`,
    })),
};
---

<Layout
    title="Experience | Edward Silva"
    description="Professional experience, with details on each role."
    jsonLd={experiencesJsonLd}
>
    <Header />
    <main
        id="main-content"
        tabindex="-1"
        class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8"
    >
        <section class="border-b border-line pb-8 sm:pb-10">
            <h1 class="font-serif text-3xl text-ink sm:text-4xl">Experience</h1>
        </section>

        <section class="divide-y divide-line" role="region" aria-label="Work Experience Directory">
            {
                experiences.map((experience) => {
                    const experienceHref = `/experiences/${getExperienceSlug(experience)}`;
                    const summary = experience.Summary ?? getExperienceHighlights(experience)[0];
                    const relatedSkills = getExperienceSkills(experience);
                    return (
                        <article class="py-8 sm:py-10">
                            <header class="mb-3">
                                <h2 class="font-serif text-lg text-ink sm:text-xl">
                                    <a
                                        href={experienceHref}
                                        class="hover:text-accent hover:underline underline-offset-4"
                                    >
                                        {experience.title}
                                    </a>
                                </h2>
                                <p class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                                    {experience.companyUrl ? (
                                        <a
                                            href={experience.companyUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="font-medium text-ink hover:text-accent hover:underline underline-offset-4"
                                            aria-label={`${experience.company} website (opens in a new tab)`}
                                        >
                                            {experience.company}
                                            <span class="sr-only"> (opens in a new tab)</span>
                                        </a>
                                    ) : (
                                        <span class="font-medium text-ink">
                                            {experience.company}
                                        </span>
                                    )}
                                    <span class="text-dim">·</span>
                                    <span>{experience.location}</span>
                                    <span class="text-dim">·</span>
                                    <span>{experience.duration}</span>
                                </p>
                            </header>

                            <SkillLinks skills={relatedSkills} class="mt-2" />

                            {summary && (
                                <p class="mt-3 text-sm text-faint leading-relaxed sm:text-base">
                                    {summary}
                                </p>
                            )}
                        </article>
                    );
                })
            }
        </section>
    </main>
    <Footer />
</Layout>
