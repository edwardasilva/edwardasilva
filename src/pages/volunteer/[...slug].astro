---
/**
 * src/pages/volunteer/[...slug].astro
 * Volunteer Routes
 *
 * Author: Edward Silva
 * Creation Date: 25 July, 2026
 * Last Update: 25 July, 2026
 *
 * Generates the volunteer index at /volunteer and a detail page per entry. Both are
 * built from the same rest route so that neither exists while resume-data.json has no
 * volunteer entry visible on the site.
 *
 * File Structure:
 * - Imports and static path generation
 * - Route props and OG image setup
 * - Index and detail templates
 *
 * Where this file is used within the repository:
 * - Public routes /volunteer and /volunteer/[slug]
 *
 * Licence/Copyright: Licensed under MIT License
 */

import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProofRenderer from '../../components/ProofRenderer.astro';
import SkillLinks from '../../components/SkillLinks.astro';
import VolunteerEntry from '../../components/VolunteerEntry.astro';
import {
    getPublicVolunteer,
    getVolunteerHighlights,
    getVolunteerSkills,
    getVolunteerSlug,
} from '../../data/resume';
import type { Volunteer } from '../../data/types';
import Layout from '../../layouts/Layout.astro';

/**
 * @brief Returns static route params for the volunteer index and each detail page.
 * @return Static path list, empty while no volunteer entry is visible on the site.
 * @details An undefined slug renders the index; a slug renders that entry's detail page.
 */
export function getStaticPaths() {
    const entries = getPublicVolunteer();

    if (entries.length === 0) {
        return [];
    }

    return [
        { params: { slug: undefined }, props: { volunteer: undefined, entries } },
        ...entries.map((volunteer) => ({
            params: { slug: getVolunteerSlug(volunteer) },
            props: { volunteer, entries },
        })),
    ];
}

const { volunteer, entries } = Astro.props as {
    volunteer: Volunteer | undefined;
    entries: Volunteer[];
};

const highlights = volunteer ? getVolunteerHighlights(volunteer) : [];
const relatedSkills = volunteer ? getVolunteerSkills(volunteer) : [];
const proof = volunteer?.proof ?? [];

const title = volunteer ? `${volunteer.title} | Volunteer` : 'Volunteer | Edward Silva';
const description = volunteer
    ? (volunteer.Summary ?? highlights[0] ?? volunteer.title)
    : 'Volunteer work, with details on each role.';
const ogImage = volunteer ? `/og/${getVolunteerSlug(volunteer)}.png` : undefined;
---

<Layout title={title} description={description} ogImage={ogImage}>
    <Header />
    <main class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
        {
            volunteer ? (
                <>
                    <section class="border-b border-line pb-8 sm:pb-10">
                        <h1 class="font-serif text-3xl text-ink sm:text-4xl">{volunteer.title}</h1>
                        <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
                            {volunteer.organizationUrl ? (
                                <a
                                    href={volunteer.organizationUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="font-medium hover:text-accent hover:underline underline-offset-4"
                                >
                                    {volunteer.organization}
                                </a>
                            ) : (
                                <span class="font-medium">{volunteer.organization}</span>
                            )}
                            {volunteer.location && (
                                <>
                                    <span aria-hidden="true" class="h-3 w-px bg-line" />
                                    <span>{volunteer.location}</span>
                                </>
                            )}
                            {volunteer.duration && (
                                <>
                                    <span aria-hidden="true" class="h-3 w-px bg-line" />
                                    <span>{volunteer.duration}</span>
                                </>
                            )}
                        </p>

                        <SkillLinks skills={relatedSkills} class="mt-3" />

                        {volunteer.Summary && (
                            <p class="mt-4 text-base text-faint">{volunteer.Summary}</p>
                        )}
                    </section>

                    {highlights.length > 0 && (
                        <section class="border-b border-line py-8 last:border-0 last:pb-0 sm:py-10">
                            <h2 class="font-serif text-xl text-ink sm:text-2xl">Highlights</h2>
                            <ul class="list-dash mt-4 space-y-3 text-sm text-faint sm:text-base">
                                {highlights.map((line) => (
                                    <li>{line}</li>
                                ))}
                            </ul>
                        </section>
                    )}

                    {proof.length > 0 && (
                        <section class="space-y-4 pt-8 sm:pt-10">
                            <h2 class="font-serif text-xl text-ink sm:text-2xl">Reports & media</h2>
                            <div class="flex flex-wrap gap-4">
                                {proof.map((item) => (
                                    <ProofRenderer proof={item} />
                                ))}
                            </div>
                        </section>
                    )}
                </>
            ) : (
                <>
                    <section class="border-b border-line pb-8 sm:pb-10">
                        <h1 class="font-serif text-3xl text-ink sm:text-4xl">Volunteer</h1>
                    </section>

                    <section class="divide-y divide-line">
                        {entries.map((entry) => (
                            <div class="py-8 sm:py-10">
                                <VolunteerEntry volunteer={entry} />
                            </div>
                        ))}
                    </section>
                </>
            )
        }
    </main>
    <Footer />
</Layout>
