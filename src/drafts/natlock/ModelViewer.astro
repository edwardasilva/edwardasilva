---
/**
 * src/drafts/natlock/ModelViewer.astro
 * Model Viewer
 *
 * Author: Edward Silva
 * Creation Date: 07 November, 2026
 * Last Update: 07 November, 2026
 *
 * Live figure: turns a binary glTF model with the mouse, a finger, or the arrow keys. The model has
 * positions only, so this reads them directly and shades each triangle flat. Without WebGL or
 * JavaScript, the figure keeps its still image.
 *
 * File Structure:
 * - Props: model URL, still image, alt text, and figure number
 * - readPositions: pulls the vertex positions out of a .glb file
 * - buildMesh: centers and scales the model and adds flat normals
 * - startViewer: draws the model and binds the controls
 *
 * Used in: src/drafts/natlock/natlock.mdx, which is unpublished
 *
 * Usage:
 * $ `npm run dev` : Runs once the page is moved as src/drafts/natlock/README.md describes
 *
 * Copyright (c) 2026 Edward Silva. All rights reserved.
 * NOTICE: This file contains personal biographical data.
 * It is strictly excluded from the repository's MIT License and
 * may not be reproduced, distributed, or modified without permission.
 */

import type { ImageMetadata } from 'astro';

interface Props {
    src: string;
    fallback: ImageMetadata;
    alt: string;
    number: number;
}

const { src, fallback, alt, number } = Astro.props;
---

<figure class="es-fig es-model" data-model={src}>
    <img
        src={fallback.src}
        width={fallback.width}
        height={fallback.height}
        alt={alt}
        loading="lazy"
        decoding="async"
    />
    <canvas hidden tabindex="0" role="img" aria-label={alt}></canvas>
    <figcaption>
        <span class="es-fignum">Figure {number}</span>
        <span><slot /></span>
    </figcaption>
</figure>

<style>
    .es-model > [hidden] {
        display: none;
    }

    .es-model > canvas {
        display: block;
        width: 100%;
        max-width: 640px;
        aspect-ratio: 886 / 679;
        margin: 0 auto;
        cursor: grab;
        touch-action: pan-y;
    }

    .es-model > canvas:active {
        cursor: grabbing;
    }
</style>

<script>
    const C_FIELDS_PER_VERTEX = 6;
    const C_CAMERA_DISTANCE = 3.2;
    const C_LENS = 3.6;
    const C_DRAG_SPEED = 0.01;
    const C_KEY_STEP = 0.15;
    const C_MAX_PITCH = 1.3;
    const C_START_YAW = 1.1;
    const C_START_PITCH = 0.25;

    const C_VERTEX_SHADER = `
        attribute vec3 position;
        attribute vec3 normal;
        uniform mat3 turn;
        uniform vec2 lens;
        uniform float camera;
        varying vec3 shade;

        void main() {
            vec3 turned = turn * position;
            float depth = camera - turned.z;

            shade = turn * normal;
            gl_Position = vec4(turned.xy * lens, -0.5 * turned.z * depth, depth);
        }
    `;

    const C_FRAGMENT_SHADER = `
        precision mediump float;
        varying vec3 shade;

        void main() {
            vec3 facing = normalize(shade);
            float key = abs(dot(facing, normalize(vec3(0.4, 0.7, 0.6))));
            float fill = abs(dot(facing, normalize(vec3(-0.7, 0.1, 0.5))));
            float light = 0.38 + 0.5 * key + 0.16 * fill;

            gl_FragColor = vec4(vec3(0.72, 0.74, 0.78) * light, 1.0);
        }
    `;

    /**
     * @brief Pulls the vertex positions out of a binary glTF file
     * @param buffer Contents of the .glb file
     * @return Packed x, y, and z values, three per vertex
     */
    function readPositions(buffer: ArrayBuffer): Float32Array {
        const header = new DataView(buffer);
        const jsonLength = header.getUint32(12, true);
        const json = JSON.parse(new TextDecoder().decode(buffer.slice(20, 20 + jsonLength)));
        const binaryStart = 28 + jsonLength;
        const accessor = json.accessors[json.meshes[0].primitives[0].attributes.POSITION];
        const view = json.bufferViews[accessor.bufferView];
        const start = binaryStart + (view.byteOffset ?? 0) + (accessor.byteOffset ?? 0);

        return new Float32Array(buffer.slice(start, start + accessor.count * 12));
    }

    /**
     * @brief Centers the model in a unit sphere and gives each triangle a flat normal
     * @param positions Packed x, y, and z values, three vertices per triangle
     * @return Interleaved position and normal values
     */
    function buildMesh(positions: Float32Array): Float32Array {
        const low = [Infinity, Infinity, Infinity];
        const high = [-Infinity, -Infinity, -Infinity];

        positions.forEach((value, index) => {
            low[index % 3] = Math.min(low[index % 3], value);
            high[index % 3] = Math.max(high[index % 3], value);
        });

        const center = low.map((value, axis) => (value + high[axis]) / 2);
        const radius = Math.hypot(...low.map((value, axis) => high[axis] - value)) / 2;
        const mesh = new Float32Array((positions.length / 3) * C_FIELDS_PER_VERTEX);

        for (let first = 0; first + 8 < positions.length; first += 9) {
            const corner = [0, 3, 6].map((offset) =>
                [0, 1, 2].map((axis) => (positions[first + offset + axis] - center[axis]) / radius)
            );
            const edgeA = corner[1].map((value, axis) => value - corner[0][axis]);
            const edgeB = corner[2].map((value, axis) => value - corner[0][axis]);
            const normal = [
                edgeA[1] * edgeB[2] - edgeA[2] * edgeB[1],
                edgeA[2] * edgeB[0] - edgeA[0] * edgeB[2],
                edgeA[0] * edgeB[1] - edgeA[1] * edgeB[0],
            ];

            corner.forEach((point, vertex) => {
                mesh.set([...point, ...normal], (first / 3 + vertex) * C_FIELDS_PER_VERTEX);
            });
        }

        return mesh;
    }

    /**
     * @brief Compiles one shader
     * @param gl WebGL context
     * @param type Vertex or fragment shader type
     * @param source Shader source text
     * @return Compiled shader
     */
    function compileShader(gl: WebGLRenderingContext, type: number, source: string): WebGLShader {
        const shader = gl.createShader(type)!;

        gl.shaderSource(shader, source);
        gl.compileShader(shader);

        return shader;
    }

    /**
     * @brief Draws a model into a figure and binds its controls
     * @param root Figure holding the still image and the canvas
     * @return Resolves once the first frame is drawn, or leaves the still image in place
     */
    async function startViewer(root: HTMLElement): Promise<void> {
        const canvas = root.querySelector('canvas')!;
        const still = root.querySelector('img')!;
        const gl = canvas.getContext('webgl', { antialias: true });

        if (!gl) {
            return;
        }

        const response = await fetch(root.dataset.model!);
        const mesh = buildMesh(readPositions(await response.arrayBuffer()));
        const program = gl.createProgram()!;

        gl.attachShader(program, compileShader(gl, gl.VERTEX_SHADER, C_VERTEX_SHADER));
        gl.attachShader(program, compileShader(gl, gl.FRAGMENT_SHADER, C_FRAGMENT_SHADER));
        gl.linkProgram(program);
        gl.useProgram(program);

        gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
        gl.bufferData(gl.ARRAY_BUFFER, mesh, gl.STATIC_DRAW);

        const stride = C_FIELDS_PER_VERTEX * 4;
        const position = gl.getAttribLocation(program, 'position');
        const normal = gl.getAttribLocation(program, 'normal');
        const turn = gl.getUniformLocation(program, 'turn');
        const lens = gl.getUniformLocation(program, 'lens');

        gl.enableVertexAttribArray(position);
        gl.vertexAttribPointer(position, 3, gl.FLOAT, false, stride, 0);
        gl.enableVertexAttribArray(normal);
        gl.vertexAttribPointer(normal, 3, gl.FLOAT, false, stride, 12);
        gl.uniform1f(gl.getUniformLocation(program, 'camera'), C_CAMERA_DISTANCE);
        gl.enable(gl.DEPTH_TEST);
        gl.clearColor(0, 0, 0, 0);

        let yaw = C_START_YAW;
        let pitch = C_START_PITCH;
        let dragging = false;

        /**
         * @brief Sizes the canvas to its box and draws one frame
         * @return Nothing
         */
        const draw = (): void => {
            const scale = Math.min(window.devicePixelRatio || 1, 2);
            const width = Math.round(canvas.clientWidth * scale);
            const height = Math.round(canvas.clientHeight * scale);

            if (canvas.width !== width || canvas.height !== height) {
                canvas.width = width;
                canvas.height = height;
                gl.viewport(0, 0, width, height);
            }

            const [cosYaw, sinYaw] = [Math.cos(yaw), Math.sin(yaw)];
            const [cosPitch, sinPitch] = [Math.cos(pitch), Math.sin(pitch)];

            gl.uniformMatrix3fv(turn, false, [
                cosYaw,
                sinPitch * sinYaw,
                -cosPitch * sinYaw,
                0,
                cosPitch,
                sinPitch,
                sinYaw,
                -sinPitch * cosYaw,
                cosPitch * cosYaw,
            ]);
            gl.uniform2f(lens, (C_LENS * height) / width, C_LENS);
            gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);
            gl.drawArrays(gl.TRIANGLES, 0, mesh.length / C_FIELDS_PER_VERTEX);
        };

        /**
         * @brief Turns the model and redraws it
         * @param yawChange Change in rotation around the vertical axis, in radians
         * @param pitchChange Change in tilt, in radians
         * @return Nothing
         */
        const rotate = (yawChange: number, pitchChange: number): void => {
            yaw += yawChange;
            pitch = Math.max(-C_MAX_PITCH, Math.min(C_MAX_PITCH, pitch + pitchChange));
            draw();
        };

        canvas.addEventListener('pointerdown', (event) => {
            dragging = true;
            canvas.setPointerCapture(event.pointerId);
        });

        canvas.addEventListener('pointerup', () => {
            dragging = false;
        });

        canvas.addEventListener('pointercancel', () => {
            dragging = false;
        });

        canvas.addEventListener('pointermove', (event) => {
            if (dragging) {
                rotate(event.movementX * C_DRAG_SPEED, event.movementY * C_DRAG_SPEED);
            }
        });

        canvas.addEventListener('keydown', (event) => {
            const steps: Record<string, [number, number]> = {
                ArrowLeft: [-C_KEY_STEP, 0],
                ArrowRight: [C_KEY_STEP, 0],
                ArrowUp: [0, -C_KEY_STEP],
                ArrowDown: [0, C_KEY_STEP],
            };
            const step = steps[event.key];

            if (step) {
                event.preventDefault();
                rotate(step[0], step[1]);
            }
        });

        canvas.addEventListener('webglcontextlost', () => {
            canvas.hidden = true;
            still.hidden = false;
        });

        canvas.hidden = false;
        still.hidden = true;
        new ResizeObserver(draw).observe(canvas);
    }

    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (entry.isIntersecting) {
                    observer.unobserve(entry.target);
                    void startViewer(entry.target as HTMLElement);
                }
            }
        },
        { rootMargin: '200px' }
    );

    for (const root of document.querySelectorAll<HTMLElement>('[data-model]')) {
        observer.observe(root);
    }
</script>
