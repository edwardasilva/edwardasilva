---
/**
 * src/components/ProofRenderer.astro
 * Proof Renderer Component
 *
 * Author: Edward Silva
 * Creation Date: 30 March, 2026
 * Last Update: 25 July, 2026
 *
 * Renders proof materials for projects, experiences, and volunteer entries.
 * Images and videos display inline, PDFs show a first-page preview image
 * linking to the full document, and files/links render as compact document cards.
 *
 * File Structure:
 * - Type Handlers: Inline media, PDF preview, and document card branches
 * - Template: Proof layout per type
 *
 * Used in: src/pages/projects/[slug].astro, src/pages/experiences/[slug].astro,
 * src/pages/volunteer/[slug].astro
 *
 * Licence/Copyright: Licensed under MIT License
 */

import type { Proof } from '../data/types';

interface Props {
    proof: Proof;
}

const { proof } = Astro.props;
const isDocument = proof.type === 'file' || proof.type === 'link';
const documentLabel = proof.type === 'link' ? 'Link' : 'File';

// First-page preview generated by scripts/generate-pdf-thumbs.js
const pdfThumbUrl =
    proof.type === 'pdf'
        ? '/assets/thumbs/' +
          proof.url
              .replace(/^\/assets\//, '')
              .replace(/\.pdf$/i, '.png')
              .replace(/\//g, '-')
        : null;
---

{
    isDocument ? (
        <a
            href={proof.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 rounded-lg border border-line bg-white p-4 transition-colors hover:border-accent-soft sm:p-5"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="shrink-0 text-faint group-hover:text-accent"
            >
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                <path d="M10 9H8" />
                <path d="M16 13H8" />
                <path d="M16 17H8" />
            </svg>
            <span class="min-w-0">
                <span class="block text-base font-semibold text-ink group-hover:text-accent">
                    {proof.title}
                </span>
                {proof.description && (
                    <span class="mt-0.5 block text-sm text-faint">{proof.description}</span>
                )}
            </span>
            <span class="ml-auto shrink-0 text-xs font-medium text-dim">{documentLabel}</span>
        </a>
    ) : proof.type === 'pdf' && pdfThumbUrl ? (
        <a
            href={proof.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group w-full max-w-[16rem] overflow-hidden rounded-lg border border-line bg-white transition-colors hover:border-accent-soft"
        >
            <span class="block overflow-hidden border-b border-line">
                <img
                    src={pdfThumbUrl}
                    alt={`First page of ${proof.title}`}
                    loading="lazy"
                    class="h-48 w-full object-cover object-top"
                />
            </span>
            <span class="block p-4">
                <span class="block text-sm font-semibold text-ink group-hover:text-accent">
                    {proof.title}
                </span>
                {proof.description && (
                    <span class="mt-1 block text-xs text-faint">{proof.description}</span>
                )}
                <span class="mt-1.5 block text-xs font-medium text-dim">PDF</span>
            </span>
        </a>
    ) : (
        <article class="w-full rounded-lg border border-line bg-white p-4 sm:p-5">
            <div class="mb-3">
                <h3 class="text-base font-semibold text-ink">{proof.title}</h3>
                {proof.description && <p class="mt-1 text-sm text-faint">{proof.description}</p>}
            </div>

            {proof.type === 'image' && (
                <img
                    src={proof.url}
                    alt={proof.title}
                    loading="lazy"
                    class="w-full rounded-lg border border-line"
                />
            )}

            {proof.type === 'video' &&
                (proof.embedUrl ? (
                    <iframe
                        src={proof.embedUrl}
                        title={proof.title}
                        class="h-80 w-full rounded-lg border border-line"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                    />
                ) : (
                    <video controls class="h-80 w-full rounded-lg border border-line bg-black">
                        <source src={proof.url} />
                        Your browser does not support video playback.
                    </video>
                ))}
        </article>
    )
}
