import ExternalLink from './ExternalLink.astro';
import PdfViewer from './PdfViewer.astro';
import type { Proof } from '../data/types';

interface Props {
    proof: Proof;
}

const { proof } = Astro.props;
const isDocument = proof.type === 'file' || proof.type === 'link';
const label = proof.title.charAt(0) + proof.title.slice(1).toLowerCase();

// First-page preview generated by scripts/generate-pdf-thumbs.js
const pdfThumbUrl = `/assets/thumbs/${proof.url
    .replace(/^\/assets\//, '')
    .replace(/\.pdf$/i, '.png')
    .replace(/\//g, '-')}`;
---

{isDocument && (
    <ExternalLink href={proof.url} class="es-proof-card">
        {label}
    </ExternalLink>
)}

{proof.type === 'pdf' && (
    <div class="es-proof-report">
        <a
            href={proof.url}
            class="es-proof-pdf"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open ${label} as a PDF (opens in a new tab)`}
        >
            <img src={pdfThumbUrl} alt="" loading="lazy" decoding="async" />
            <span>{label}, PDF</span>
        </a>
        <PdfViewer url={proof.url} label={label} />
    </div>
)}

{proof.type === 'image' && (
    <figure class="es-proof-media">
        <img src={proof.url} alt={label} loading="lazy" decoding="async" />
        <figcaption>{label}</figcaption>
    </figure>
)}

{proof.type === 'video' && (
    <figure class="es-proof-media es-proof-video">
        <video controls preload="metadata">
            <source src={proof.url} />
        </video>
        <figcaption>{label}</figcaption>
    </figure>
)}
