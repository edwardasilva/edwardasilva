import ExternalLink from './ExternalLink.astro';
import SkillLinks from './SkillLinks.astro';
import { getExperienceSlug, visibleExperiences } from '../data/resume';

interface Props {
    slug: string;
}

const { slug } = Astro.props;
const experience = visibleExperiences.find((candidate) => getExperienceSlug(candidate) === slug);

if (!experience) {
    throw new Error(`[ERROR] No visible experience in resume-data.json has the slug ${slug}`);
}
---

<dl class="es-facts">
    <div>
        <dt>Role</dt>
        <dd>{experience.title}</dd>
    </div>
    <div>
        <dt>When</dt>
        <dd>{experience.duration}</dd>
    </div>
    {
        experience.employmentType && (
            <div>
                <dt>Type</dt>
                <dd>{experience.employmentType}</dd>
            </div>
        )
    }
    {
        experience.location && (
            <div>
                <dt>Where</dt>
                <dd>{experience.location}</dd>
            </div>
        )
    }
    {
        experience.skills.length > 0 && (
            <div>
                <dt>Tools</dt>
                <dd>
                    <SkillLinks skills={experience.skills} />
                </dd>
            </div>
        )
    }
    {
        experience.companyUrl && (
            <div>
                <dt>Links</dt>
                <dd class="es-facts-links">
                    <ExternalLink href={experience.companyUrl}>{experience.company}</ExternalLink>
                </dd>
            </div>
        )
    }
</dl>
