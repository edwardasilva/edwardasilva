---
/**
 * src/components/RoleFacts.astro
 * Role Facts
 *
 * Author: Edward Silva
 * Creation Date: 08 November, 2026
 * Last Update: 08 November, 2026
 *
 * The role, dates, employment type, place, and tools under a role page title, in the same block
 * the project pages use.
 *
 * File Structure:
 * - Match the page to resume-data.json by slug
 * - Definition list of facts
 *
 * Where this file is used within the repository:
 * - src/components/PageTitle.astro
 *
 * Usage:
 * $ `npm run dev` : Renders in the local development server
 *
 * Copyright (c) 2026 Edward Silva. MIT License.
 */

import ExternalLink from './ExternalLink.astro';
import SkillLinks from './SkillLinks.astro';
import { getExperienceSlug, visibleExperiences } from '../data/resume';

interface Props {
    slug: string;
}

const { slug } = Astro.props;
const experience = visibleExperiences.find((candidate) => getExperienceSlug(candidate) === slug);

if (!experience) {
    throw new Error(`[ERROR] No visible experience in resume-data.json has the slug ${slug}`);
}
---

{/* The page body repeats these facts. Left out of search, the labels and values no longer
    run together in excerpts ("WhenOngoing"). */}
<dl class="es-facts" data-pagefind-ignore>
    <div>
        <dt>Role</dt>
        <dd>{experience.title}</dd>
    </div>
    <div>
        <dt>When</dt>
        <dd>{experience.duration}</dd>
    </div>
    {experience.employmentType && (
        <div>
            <dt>Type</dt>
            <dd>{experience.employmentType}</dd>
        </div>
    )}
    {experience.location && (
        <div>
            <dt>Where</dt>
            <dd>{experience.location}</dd>
        </div>
    )}
    {experience.skills.length > 0 && (
        <div>
            <dt>Tools</dt>
            <dd>
                <SkillLinks skills={experience.skills} />
            </dd>
        </div>
    )}
    {experience.companyUrl && (
        <div>
            <dt>Links</dt>
            <dd class="es-facts-links">
                <ExternalLink href={experience.companyUrl}>{experience.company}</ExternalLink>
            </dd>
        </div>
    )}
</dl>
