---
/**
 * src/components/Volunteer.astro
 * Volunteer Component
 *
 * Author: Edward Silva
 * Creation Date: 25 July, 2026
 * Last Update: 25 July, 2026
 *
 * Displays volunteer work as a stacked list in the same format as the Experience
 * section. Renders nothing while no volunteer entry is visible on the site.
 *
 * File Structure:
 * - Data Filtering: Visible volunteer entry lookup
 * - Template: Section wrapper around the shared entry component
 *
 * Used in: src/pages/index.astro
 *
 * Licence/Copyright: Licensed under MIT License
 */

import Section from './Section.astro';
import VolunteerEntry from './VolunteerEntry.astro';
import { getPublicVolunteer, resume } from '../data/resume';

const volunteer = getPublicVolunteer(resume);
---

{
    volunteer.length > 0 && (
        <Section id="volunteer" title="Volunteer">
            <div class="space-y-10">
                {volunteer.map((entry) => (
                    <VolunteerEntry volunteer={entry} />
                ))}
            </div>

            <a
                href="/volunteer"
                class="mt-10 inline-block text-sm font-medium text-accent hover:text-accent-deep hover:underline underline-offset-4"
            >
                All volunteer work
            </a>
        </Section>
    )
}
