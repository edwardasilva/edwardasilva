---
/**
 * src/components/PageTitle.astro
 * Page Title
 *
 * Author: Edward Silva
 * Creation Date: 07 November, 2026
 * Last Update: 08 November, 2026
 *
 * The page heading, followed by the facts block on project and role pages. The home page has its
 * own heading.
 *
 * File Structure:
 * - Heading
 * - ProjectFacts on project pages
 * - RoleFacts on role pages
 *
 * Where this file is used within the repository:
 * - Starlight PageTitle override, set in astro.config.mjs
 *
 * Usage:
 * $ `npm run dev` : Renders in the local development server
 *
 * Copyright (c) 2026 Edward Silva. MIT License.
 */

import ProjectFacts from './ProjectFacts.astro';
import RoleFacts from './RoleFacts.astro';
import { getPageProject } from '../data/projects';

const { entry } = Astro.locals.starlightRoute;
const splash = entry.data.template === 'splash';
const project = getPageProject(entry.id);
---

{!splash && (
    <h1 id="_top" data-pagefind-meta="title">
        {entry.data.title}
    </h1>
)}
{project && <ProjectFacts />}
{entry.data.role && <RoleFacts slug={entry.data.role} />}
