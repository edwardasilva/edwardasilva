import SkillLinks from './SkillLinks.astro';
import { getCourseCopy } from '../data/course-copy';
import { getDisplayTitle } from '../data/projects';
import { getCourseSlug, getProjectHref, getProjectsForCourse } from '../data/resume';
import type { Course } from '../data/types';

interface Props {
    course: Course;
}

const { course } = Astro.props;
const projects = getProjectsForCourse(course);
---

<details id={getCourseSlug(course)} class="es-course">
    <summary>
        <code>{course.code}</code>
        <span>{course.name}</span>
    </summary>
    <p>{getCourseCopy(course)}</p>
    {
        course.skills.length > 0 && (
            <p class="es-course-meta">
                Skills: <SkillLinks skills={course.skills} />
            </p>
        )
    }
    {
        projects.length > 0 && (
            <p class="es-course-meta">
                {projects.length === 1 ? 'Project: ' : 'Projects: '}
                {projects.map((project, index) => (
                    <>
                        {index > 0 && ', '}
                        <a href={getProjectHref(project)}>
                            {getDisplayTitle(getProjectHref(project), project.title)}
                        </a>
                    </>
                ))}
            </p>
        )
    }
</details>
