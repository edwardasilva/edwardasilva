---
/**
 * src/components/ProjectFacts.astro
 * Project Facts
 *
 * Author: Edward Silva
 * Creation Date: 07 November, 2026
 * Last Update: 16 November, 2026
 *
 * When, which course, who was on the team, and which part was mine, under a project title. This is
 * what a profile page flattens. Every fact comes from the page's entry in resume-data.json. A page
 * with no entry, or one marked Hide, fails the build. When and Course share a row once the column
 * has room, the same two columns the role pages use. The client, the sponsor, and the advisors each
 * get a row of their own under Team.
 *
 * File Structure:
 * - Match the page to resume-data.json by slug
 * - Definition list of facts
 *
 * Where this file is used within the repository:
 * - src/components/PageTitle.astro
 *
 * Usage:
 * $ `npm run dev` : Renders in the local development server
 *
 * Copyright (c) 2026 Edward Silva. All rights reserved.
 */

import ExternalLink from './ExternalLink.astro';
import SkillLinks from './SkillLinks.astro';
import { asSentence, getCourseByCode, getCourseHref } from '../data/resume';
import { getPageProject } from '../data/projects';

const { id } = Astro.locals.starlightRoute;
const project = getPageProject(id);

if (!project) {
    throw new Error(`[ERROR] ${id} is not a project write-up`);
}

const {
    course: courseCode,
    duration: dates,
    team,
    client,
    sponsor,
    advisors,
    myPart,
    skills,
} = project;
const course = courseCode ? getCourseByCode(courseCode) : undefined;
const courseHref = courseCode ? getCourseHref(courseCode) : undefined;
// Team, then the client, the sponsor, and the advisors, each on a row of its own.
const people = [
    ['Team', team],
    ['Client', client],
    ['Sponsor', sponsor],
    ['Advisors', advisors],
] as const;
const allLinks = [
    ...project.links,
    ...(project.github ? [{ label: 'Source on GitHub', href: project.github }] : []),
];
---

{/* The page body repeats these facts. Left out of search, the labels and values no longer
    run together in excerpts ("WhenOngoing"). */}
<div class="es-facts-frame">
    <dl class="es-facts es-facts-split" data-pagefind-ignore>
        {dates && (
            <div>
                <dt>When</dt>
                <dd>{dates}</dd>
            </div>
        )}
        {courseCode && (
            <div>
                <dt>Course</dt>
                <dd>
                    {courseHref ? <a href={courseHref}>{courseCode}</a> : courseCode}
                    {course && `, ${course.name}`}
                </dd>
            </div>
        )}
        {people.map(
            ([label, value]) =>
                value && (
                    <div class="es-facts-wide">
                        <dt>{label}</dt>
                        <dd>{value}</dd>
                    </div>
                )
        )}
        {myPart && (
            <div class="es-facts-wide">
                <dt>My part</dt>
                <dd>{asSentence(myPart)}</dd>
            </div>
        )}
        {skills.length > 0 && (
            <div class="es-facts-wide">
                <dt>Skills</dt>
                <dd>
                    <SkillLinks skills={skills} />
                </dd>
            </div>
        )}
        {allLinks.length > 0 && (
            <div class="es-facts-wide">
                <dt>Links</dt>
                <dd class="es-facts-links">
                    {allLinks.map((link) => (
                        <ExternalLink href={link.href}>{link.label}</ExternalLink>
                    ))}
                </dd>
            </div>
        )}
    </dl>
</div>
