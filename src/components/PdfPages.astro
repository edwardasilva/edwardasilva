---
/**
 * src/components/PdfPages.astro
 * PDF Page Viewer
 *
 * Author: Edward Silva
 * Creation Date: 14 November, 2026
 * Last Update: 14 November, 2026
 *
 * Draws every page of one PDF into the page with PDF.js, scaled to the content column. Moved out
 * of src/pages/resume/viewer.astro so the resume and the CV share one viewer.
 *
 * File Structure:
 * - Props: the PDF's URL and the document name used in status text and page labels
 * - Status line and page host
 * - Inline viewer script
 *
 * Where this file is used within the repository:
 * - src/pages/resume/viewer.astro and src/pages/resume/cv.astro
 *
 * Usage:
 * $ `<PdfPages url="/resume/Edward_Silva_Resume.pdf" name="resume" />` : Draws the resume
 *
 * Copyright (c) 2026 Edward Silva. All rights reserved.
 */

interface Props {
    /** URL of the PDF to draw */
    url: string;
    /** Lowercase document name, such as "resume" or "CV" */
    name: string;
}

const { url, name } = Astro.props;
---

<p id="pdf-status">Loading {name}.</p>
<div id="pdf-pages" data-pdf-url={url} data-pdf-name={name} class="es-resume not-content"></div>

<script is:inline type="module">
    import { getDocument, GlobalWorkerOptions } from '/vendor/pdf.min.mjs';

    const status = document.getElementById('pdf-status');
    const host = document.getElementById('pdf-pages');
    const name = host.dataset.pdfName;

    GlobalWorkerOptions.workerSrc = '/vendor/pdf.worker.min.mjs';

    /**
     * @brief Draws each page of the PDF into the page
     * @return {Promise<void>} Resolves when every page has been painted
     * @details Scales each page to the content column and the screen pixel ratio.
     */
    async function renderPdf() {
        const pdf = await getDocument({ url: host.dataset.pdfUrl }).promise;
        const cssWidth = host.clientWidth;

        for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber += 1) {
            const page = await pdf.getPage(pageNumber);
            const base = page.getViewport({ scale: 1 });
            const scale = (cssWidth / base.width) * Math.min(window.devicePixelRatio || 1, 2);
            const viewport = page.getViewport({ scale });
            const canvas = document.createElement('canvas');
            const label = name.charAt(0).toUpperCase() + name.slice(1);

            canvas.width = viewport.width;
            canvas.height = viewport.height;
            canvas.setAttribute('role', 'img');
            canvas.setAttribute('aria-label', `${label} page ${pageNumber} of ${pdf.numPages}`);

            host.append(canvas);
            await page.render({
                canvasContext: canvas.getContext('2d'),
                viewport,
                canvas,
            }).promise;
        }

        status.hidden = true;
    }

    renderPdf().catch(() => {
        status.textContent = `The ${name} could not be drawn. Use the download link above.`;
    });
</script>
