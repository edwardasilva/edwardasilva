---
/**
 * src/components/ProjectEntry.astro
 * Project Entry Component
 *
 * Author: Edward Silva
 * Creation Date: 18 July, 2026
 * Last Update: 18 July, 2026
 *
 * Renders a single project entry for the home page list, matching the
 * Experience entry layout: title link, meta row, summary, and skills.
 *
 * File Structure:
 * - Props: project payload
 * - Template: Entry layout
 *
 * Used in: src/components/Projects.astro
 *
 * Licence/Copyright: Licensed under MIT License
 */

import { getProjectSkills, getProjectSlug } from '../data/resume';
import type { Project } from '../data/types';

interface Props {
    project: Project;
}

const { project } = Astro.props;
const relatedSkills = getProjectSkills(project);
---

<article>
    <div class="flex flex-col gap-2 mb-3">
        <h3 class="text-lg sm:text-xl font-semibold font-serif text-ink leading-snug">
            <a
                href={`/projects/${getProjectSlug(project)}`}
                class="hover:text-accent hover:underline underline-offset-4"
            >
                {project.title}
            </a>
        </h3>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-faint">
            <span>{project.duration}</span>
            {
                project.projectType && (
                    <>
                        <span aria-hidden="true" class="hidden h-3 w-px bg-line sm:block" />
                        <span>{project.projectType}</span>
                    </>
                )
            }
            {
                project.course && (
                    <>
                        <span aria-hidden="true" class="hidden h-3 w-px bg-line sm:block" />
                        <span>{project.course}</span>
                    </>
                )
            }
        </div>
    </div>

    {project.summary && <p class="text-faint leading-relaxed text-sm sm:text-base">{project.summary}</p>}

    {relatedSkills.length > 0 && <p class="mt-3 text-xs text-dim">{relatedSkills.join(', ')}</p>}
</article>
