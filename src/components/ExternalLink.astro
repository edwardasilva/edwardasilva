import { splitTail } from '../plugins/external-link-tail.js';

const { class: className, rel = 'noopener noreferrer', ...attributes } = Astro.props;
const text = (await Astro.slots.render('default')).trim();
const [head, tail] = splitTail(text);
---

<a class:list={['external-link', className]} target="_blank" rel={rel} {...attributes}>
    <span class="es-ext-text">
        <Fragment set:html={head} />
        <span class="es-ext-last">
            <Fragment set:html={tail} />
        </span>
    </span>
    <span class="sr-only"> (opens in a new tab)</span>
</a>
