---
/**
 * src/components/Projects.astro
 * Projects Component
 *
 * Author: Edward Silva
 * Creation Date: 16 March, 2026
 * Last Update: 24 August, 2026
 *
 * Displays portfolio projects as a stacked list matching the Experience
 * section: the three most recent entries, an expander for the rest, and
 * a link to the full projects page.
 *
 * File Structure:
 * - Project Processing: Visibility filtering and recency split
 * - Template: Stacked entry list with accessible expander
 *
 * Where this file is used within the repository:
 * - Rendered on home page in src/pages/index.astro
 *
 * Usage:
 * $ `npm run dev` : Rendered as part of index page template
 *
 * Copyright (c) 2026 Edward Silva. All rights reserved.
 * NOTICE: This file contains personal biographical data.
 * It is strictly excluded from the repository's MIT License and
 * may not be reproduced, distributed, or modified without permission.
 */

import Section from './Section.astro';
import ProjectEntry from './ProjectEntry.astro';
import { getPortfolioProjects } from '../data/resume';

const projects = getPortfolioProjects();
const recentProjects = projects.slice(0, 3);
const olderProjects = projects.slice(3);
---

<Section id="projects" title="Projects">
    <div class="space-y-10">
        {recentProjects.map((project) => <ProjectEntry project={project} />)}
    </div>

    {
        olderProjects.length > 0 && (
            <details id="older-projects-toggle" class="group mt-10">
                <summary
                    class="cursor-pointer select-none list-none text-sm font-medium text-faint hover:text-ink flex items-center gap-1.5"
                    aria-label="Toggle older projects display"
                >
                    <span id="older-projects-label">
                        Show more projects ({olderProjects.length})
                    </span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="group-open:rotate-180 transition-transform"
                        aria-hidden="true"
                    >
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </summary>
                <div class="mt-10 space-y-10">
                    {olderProjects.map((project) => (
                        <ProjectEntry project={project} />
                    ))}
                </div>
            </details>
        )
    }

    <a
        href="/projects"
        class="mt-10 inline-block text-sm font-medium text-accent hover:text-accent-deep hover:underline underline-offset-4"
        aria-label="View all portfolio projects"
    >
        All projects
    </a>
</Section>

<script>
    /**
     * @brief Synchronizes the summary label text when older projects details element is toggled
     * @return {void}
     */
    function setupProjectsToggle(): void {
        const toggle = document.getElementById(
            'older-projects-toggle'
        ) as HTMLDetailsElement | null;
        const label = document.getElementById('older-projects-label');
        if (toggle && label) {
            const count = toggle.querySelectorAll('.project-entry').length;
            toggle.addEventListener('toggle', () => {
                label.textContent = toggle.open
                    ? 'Show fewer projects'
                    : `Show more projects (${count})`;
            });
        }
    }

    setupProjectsToggle();
</script>
