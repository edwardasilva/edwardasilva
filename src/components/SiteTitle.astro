const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
    <span class="es-wordmark" translate="no">Edward Silva</span>
</a>

<style>
    @layer starlight.core {
        .site-title {
            align-items: center;
            color: var(--es-ink);
            text-decoration: none;
            white-space: nowrap;
            min-width: 0;
        }
    }

    .es-wordmark {
        font: 600 1.375rem/1 var(--es-font-serif);
        font-variation-settings: 'opsz' 72;
        letter-spacing: -0.01em;
    }
</style>
