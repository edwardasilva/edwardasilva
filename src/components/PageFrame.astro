---
/**
 * src/components/PageFrame.astro
 * Page Frame
 *
 * Author: Edward Silva
 * Creation Date: 07 November, 2026
 * Last Update: 07 November, 2026
 *
 * Gives pages with no sidebar the same phone menu as pages that have one. From 50rem up they stay
 * sidebar-free. Adapted from eeprep.com.
 *
 * File Structure:
 * - Menu markup for pages with no sidebar
 * - sl-sidebar-pane: focus handling Starlight only defines on pages with a sidebar
 *
 * Where this file is used within the repository:
 * - Starlight PageFrame override, set in astro.config.mjs
 *
 * Usage:
 * $ `npm run dev` : Renders in the local development server
 *
 * Copyright (c) 2026 Edward Silva. MIT License.
 */

import Default from '@astrojs/starlight/components/PageFrame.astro';
import MobileMenuToggle from 'virtual:starlight/components/MobileMenuToggle';
import Sidebar from 'virtual:starlight/components/Sidebar';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<Default>
    <Fragment slot="header">
        <slot name="header" />
        {!hasSidebar && (
            <nav
                class="es-splash-menu md:sl-hidden print:hidden"
                aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}
            >
                <MobileMenuToggle />
                <sl-sidebar-pane popover="auto" id="starlight__sidebar" class="es-splash-pane">
                    <div class="es-splash-content sidebar-content">
                        <Sidebar />
                    </div>
                </sl-sidebar-pane>
            </nav>
        )}
    </Fragment>
    <slot name="sidebar" slot="sidebar" />
    <slot />
</Default>

<script>
    if (!customElements.get('sl-sidebar-pane')) {
        customElements.define(
            'sl-sidebar-pane',
            class extends HTMLElement {
                constructor() {
                    super();

                    this.addEventListener('toggle', (event) => {
                        const open = (event as ToggleEvent).newState === 'open';

                        document
                            .querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link')
                            .forEach((element) => element.toggleAttribute('inert', open));
                    });

                    const wide = matchMedia('(min-width: 50rem)');

                    /**
                     * @brief Closes the menu and frees the page on wide screens
                     * @return Nothing
                     */
                    const reset = () => {
                        if (!wide.matches) {
                            return;
                        }

                        if (this.matches(':popover-open')) {
                            this.hidePopover();
                        }

                        document
                            .querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link')
                            .forEach((element) => element.removeAttribute('inert'));
                    };

                    reset();
                    wide.addEventListener('change', reset);
                }
            }
        );
    }
</script>

<style>
    .es-splash-pane {
        position: fixed;
        inset: var(--sl-nav-height) 0 0;
        z-index: var(--sl-z-index-menu);
        width: 100%;
        height: auto;
        margin: 0;
        border: 0;
        padding: 0;
        background-color: var(--sl-color-black);
        color: inherit;
        overflow-y: auto;
        scrollbar-gutter: stable;
    }

    .es-splash-content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-height: max-content;
        padding: 1rem var(--sl-sidebar-pad-x) 0;
    }
</style>
