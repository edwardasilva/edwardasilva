 * may not be reproduced, distributed, or modified without permission.
 */

import { getDarkFigure, getFigure } from '../data/figures';
import type { ProjectPage } from '../data/projects';
import { asSentence } from '../data/resume';

interface Props {
    pages: ProjectPage[];
    class?: string;
}

const C_DRAWINGS = new Set(['pump/sketch']);

const { pages, class: className } = Astro.props;
---

<ul class:list={['es-cards', 'not-content', className]}>
    {pages.map(({ entry, project, href }) => {
        const figure = project.figure ? getFigure(project.figure) : undefined;
        const dark = project.figure ? getDarkFigure(project.figure) : undefined;

        return (
            <li>
                <a href={href}>
                    {figure && (
                        <span
                            class:list={[
                                'es-card-figure',
                                {
                                    'es-card-photo': !dark && !C_DRAWINGS.has(project.figure ?? ''),
                                    'es-card-drawing': !dark && C_DRAWINGS.has(project.figure ?? ''),
                                },
                            ]}
                            data-figure={project.figure}
                        >
                            <img
                                class:list={{ 'dark:sl-hidden': dark }}
                                src={figure.src}
                                width={figure.width}
                                height={figure.height}
                                alt={project.figureAlt ?? ''}
                                loading="lazy"
                                decoding="async"
                            />
                            {dark && (
                                <img
                                    class="light:sl-hidden"
                                    src={dark.src}
                                    width={dark.width}
                                    height={dark.height}
                                    alt={project.figureAlt ?? ''}
                                    loading="lazy"
                                    decoding="async"
                                />
                            )}
                        </span>
                    )}
                    <strong>{entry.data.title}</strong>
                    <span class="es-card-dek">{project.dek && asSentence(project.dek)}</span>
                </a>
            </li>
        );
    })}
</ul>
