import { getFigure } from '../data/figures';
import { getPageSlug, type ProjectPage } from '../data/projects';

interface Props {
    pages: ProjectPage[];
}

const { pages } = Astro.props;
---

<ul class="es-cards not-content">
    {
        pages.map((page) => {
            const figure = page.data.figure ? getFigure(page.data.figure) : undefined;

            return (
                <li>
                    <a href={`/projects/${getPageSlug(page.id)}/`}>
                        {figure && (
                            <span class="es-card-plate">
                                <img
                                    src={figure.src}
                                    width={figure.width}
                                    height={figure.height}
                                    alt={page.data.figureAlt ?? ''}
                                    loading="lazy"
                                    decoding="async"
                                />
                            </span>
                        )}
                        <strong>{page.data.title}</strong>
                        <span class="es-card-dek">{page.data.dek}</span>
                    </a>
                </li>
            );
        })
    }
</ul>
