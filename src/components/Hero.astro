---
/**
 * src/components/Hero.astro
 * Hero Section Component
 *
 * Author: Edward Silva
 * Creation Date: 16 March, 2026
 * Last Update: 19 October, 2026
 *
 * Renders the main hero section with profile introduction, social links,
 * and call-to-action buttons for the portfolio landing page.
 *
 * File Structure:
 * - Derived data: current role, education, and profile text
 * - Template: Hero layout with typography, accessibility landmarks, and buttons
 *
 * Where this file is used within the repository:
 * - Rendered on home page in src/pages/index.astro
 *
 * Usage:
 * $ `npm run dev` : Rendered as part of index page template
 *
 * Copyright (c) 2026 Edward Silva. All rights reserved.
 * NOTICE: This file contains personal biographical data.
 * It is strictly excluded from the repository's MIT License and
 * may not be reproduced, distributed, or modified without permission.
 */

// Hero section - the big intro at the top
import {
    getPrimaryEducation,
    getProfileHighlightText,
    getPublicExperiences,
    resume,
} from '../data/resume';

const education = getPrimaryEducation();
const currentRole = getPublicExperiences()[0];
// Display title for the hero; the resume data keeps the official role title
const heroRoleTitle = 'Embedded Software Engineer';
const bio = getProfileHighlightText(resume.about);
---

<section id="hero" class="pt-14 pb-12 sm:pt-20 sm:pb-16 border-b border-line">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <!-- Name -->
        <h1
            class="text-4xl sm:text-5xl font-semibold font-serif mb-4 sm:mb-6 tracking-tight text-ink leading-[1.1]"
        >
            {resume.personal.name}
        </h1>

        <!-- Current role and education -->
        {
            currentRole && (
                <p class="text-lg sm:text-xl text-ink mb-1 font-medium">
                    {heroRoleTitle} at {currentRole.company}
                </p>
            )
        }
        {
            education && (
                <p class="text-base text-faint mb-4">
                    {education.degree}
                    {education.minor ? `, ${education.minor}` : ''} | {education.institution} (
                    {education.graduationDate})
                </p>
            )
        }

        <!-- Short bio -->
        {bio && <p class="max-w-2xl text-base sm:text-lg text-faint mb-8 leading-relaxed">{bio}</p>}

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
            <a
                href="#experience"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md bg-ink text-white text-sm font-semibold hover:bg-ink-soft"
                aria-label="Jump down to experience section"
            >
                View Experience
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    ><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg
                >
            </a>
            <a
                href="/resume/viewer"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md bg-white text-ink border border-line text-sm font-semibold hover:bg-wash"
                aria-label="Download Edward Silva Resume PDF (opens in a new tab)"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline
                        points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"
                    ></line></svg
                >
                Download Resume
                <span class="sr-only"> (opens in a new tab)</span>
            </a>
        </div>

        <!-- Quick contact links -->
        <div
            class="flex flex-wrap items-center gap-4 sm:gap-6 mt-8 sm:mt-10 pt-6 sm:pt-8 border-t border-line"
            role="region"
            aria-label="Contact and Social Links"
        >
            <a
                href={resume.personal.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-sm text-faint hover:text-ink"
                aria-label="Edward Silva on GitHub (opens in a new tab)"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    ><path
                        d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                    ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
                >
                GitHub
                <span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a
                href={resume.personal.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 text-sm text-faint hover:text-ink"
                aria-label="Edward Silva on LinkedIn (opens in a new tab)"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    ><path
                        d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                    ></path><rect width="4" height="12" x="2" y="9"></rect><circle
                        cx="4"
                        cy="4"
                        r="2"></circle></svg
                >
                LinkedIn
                <span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a
                href={`mailto:${resume.personal.email}`}
                class="flex items-center gap-2 text-sm text-faint hover:text-ink"
                aria-label={`Send email to ${resume.personal.email}`}
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                        d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
                >
                {resume.personal.email}
            </a>
        </div>
    </div>
</section>
