import ProofRenderer from './ProofRenderer.astro';
import { getProjectSlug, resume } from '../data/resume';

interface Props {
    slug: string;
    only?: string;
}

const { only } = Astro.props;
const project = resume.projects.find((candidate) => getProjectSlug(candidate) === Astro.props.slug);
---

{project && project.proof.length > 0 && (
    <div class="es-proof-list not-content">
        {project.proof
            .filter((proof) => !only || proof.type === only)
            .map((proof) => (
                <ProofRenderer proof={proof} />
            ))}
    </div>
)}
