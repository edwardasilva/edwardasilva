import { getFigure } from '../data/figures';

interface Props {
    name: string;
    alt: string;
    number: number;
    plate?: boolean;
    narrow?: boolean;
    wide?: boolean;
}

const { name, alt, number, plate = true, narrow = false, wide = false } = Astro.props;
const figure = getFigure(name);
---

<figure
    class:list={['es-fig', { 'es-fig-plate': plate, 'es-fig-narrow': narrow, 'es-fig-wide': wide }]}
>
    <img
        src={figure.src}
        width={figure.width}
        height={figure.height}
        alt={alt}
        loading="lazy"
        decoding="async"
    />
    <figcaption>
        <span class="es-fignum">Figure {number}</span>
        <span><slot /></span>
    </figcaption>
</figure>
