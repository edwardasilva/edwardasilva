---
/**
 * src/components/Figure.astro
 * Figure
 *
 * Author: Edward Silva
 * Creation Date: 07 November, 2026
 * Last Update: 09 November, 2026
 *
 * A numbered figure with a caption. An SVG plot has a dark copy, written by
 * scripts/theme-figures.js, and the figure shows whichever one matches the theme. A raster plot
 * from a report has no dark copy, so it sits on a white plate in both themes. Photos take
 * plate={false}.
 *
 * File Structure:
 * - Props: figure name, alt text, number, plate, narrow, wide
 * - A raster image goes through Picture for AVIF and WebP, and an SVG stays a plain img
 * - One image per theme when a dark copy exists, otherwise one image
 * - Caption from the default slot
 *
 * Where this file is used within the repository:
 * - Project pages
 *
 * Usage:
 * $ `npm run dev` : Renders in the local development server
 *
 * Copyright (c) 2026 Edward Silva. All rights reserved.
 * NOTICE: This file contains personal biographical data.
 * It is strictly excluded from the repository's MIT License and
 * may not be reproduced, distributed, or modified without permission.
 */

import { Picture } from 'astro:assets';
import { getDarkFigure, getFigure } from '../data/figures';

interface Props {
    name: string;
    alt: string;
    number: number;
    plate?: boolean;
    narrow?: boolean;
    wide?: boolean;
}

const { name, alt, number, plate = true, narrow = false, wide = false } = Astro.props;
const figure = getFigure(name);
const dark = getDarkFigure(name);
const onPlate = plate && !dark;
const isRaster = figure.format !== 'svg';
---

<figure
    class:list={[
        'es-fig',
        { 'es-fig-plate': onPlate, 'es-fig-narrow': narrow, 'es-fig-wide': wide },
    ]}
>
    {
        /* Both images are lazy, so the browser skips the one the theme hides. */
        dark ? (
            <>
                <img
                    class="dark:sl-hidden"
                    src={figure.src}
                    width={figure.width}
                    height={figure.height}
                    alt={alt}
                    loading="lazy"
                    decoding="async"
                />
                <img
                    class="light:sl-hidden"
                    src={dark.src}
                    width={dark.width}
                    height={dark.height}
                    alt={alt}
                    loading="lazy"
                    decoding="async"
                />
            </>
        ) : isRaster ? (
            <Picture
                src={figure}
                formats={['avif', 'webp']}
                widths={[630, 1260]}
                sizes="(min-width: 50rem) 630px, 100vw"
                alt={alt}
                loading="lazy"
                decoding="async"
            />
        ) : (
            <img
                src={figure.src}
                width={figure.width}
                height={figure.height}
                alt={alt}
                loading="lazy"
                decoding="async"
            />
        )
    }
    <figcaption>
        <span class="es-fignum">Figure {number}</span>
        <span>
            <slot />
        </span>
    </figcaption>
</figure>
