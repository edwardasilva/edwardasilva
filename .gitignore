# .gitignore
# Git Ignore Rules
#
# Author: Edward Silva
# Creation Date: [INSERT CREATION DATE HERE]
# Last Update: 08 November, 2026
#
# Lists the files Git leaves untracked, including build output, secrets, and the private resume and agent files that the hooks keep off GitHub.
#
# Usage:
# $ `git status` : Shows the working tree without the ignored paths
#
# Copyright (c) 2026 Edward Silva. All rights reserved.
# NOTICE: This file contains personal biographical data.
# It is strictly excluded from the repository's MIT License and
# may not be reproduced, distributed, or modified without permission.

# dependencies
node_modules/

# build outputs & framework caches - can be regenerated
.astro/
dist/
build/
out/
.next/
.nuxt/
.vite/
.turbo/
.vercel/
.netlify/
.parcel-cache/

# resume and local content artifacts
public/resume/*.tex
public/vendor/
public/assets/
previousjobs/

# LaTeX compilation artifacts (from resume generation)
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot
*.bbl
*.blg
*.xdv

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
ENV/

# logs - never commit
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables and secrets
.env
.env*
!.env.example
*.env

# credentials, tokens, SSH keys, and certificates
*.pem
*.key
*.crt
*.p12
*.pfx
*.asc
*.p8
*.keystore
*.jks
*.kdbx
credentials.json
secrets.json
service-account*.json
gcp-key*.json
aws-credentials*
id_rsa
id_ed25519
id_ecdsa
id_dsa
*.id_rsa
.netrc

# local databases, temporary files, and caches
*.sqlite
*.sqlite3
*.db
.cache/
.tmp/
tmp/
temp/
coverage/
.nyc_output/
*.lcov

# IDE and editor files
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*.swn
*~
*.bak
*.tmp
*.temp
*.orig
*.rej

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# AI agent & local assistant directories / state
.agents/
.gemini/
.claude/
.copilot/
.cursor/

# Private files now live in the information/ submodule (edwardasilva/information).
# These root names stay listed so a stray copy can never be committed.
AGENTS.md
STYLE.md
TODO.md
CLAUDE.md
GEMINI.md
.cursorrules
SKILL.md
docs/**
resume-data.json

# local editor settings
.editorconfig
