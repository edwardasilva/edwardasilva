# public/_headers
# Cloudflare Pages response headers
#
# Author: Edward Silva
# Creation Date: 10 November, 2026
# Last Update: 10 November, 2026
#
# Blocks framing and turns off browser features the site does not use.
# Pages copies this file to dist/_headers on build.
#
# Copyright (c) 2026 Edward Silva. All rights reserved.

/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
